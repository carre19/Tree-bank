PORT=3001
NODE_ENV=development

# Datos de conexion a la base de datos (Supabase o PostgreSQL local)
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# API del Banco Central (provista por el profesor)
CENTRAL_BANK_URL=https://centralbank.brocoly.cc/api
CENTRAL_BANK_API_KEY=
X_ENVIRONMENT=test

# Bearer token del docente, usado UNA sola vez para registrar el banco (POST /banks).
# Es distinto de CENTRAL_BANK_API_KEY: ese se usa en todos los demas endpoints.
CENTRAL_BANK_REGISTER_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Cotizacion del dolar oficial: solo se usa si el Banco Central y DolarAPI
# fallan (sin internet). En uso normal viene de https://dolarapi.com/v1/dolares/oficial
COTIZACION_USD_FALLBACK_COMPRA=1000
COTIZACION_USD_FALLBACK_VENTA=1050

# Numero de banco asignado
NUMERO_BANK=

# Clave secreta para JWT (poner cualquier cadena larga y random).
# Es obligatoria: sin esto el servidor no arranca.
JWT_SECRET=

# Origenes autorizados a llamar la API desde el navegador (CORS), separados por coma.
# Si se deja vacio se permiten los puertos locales de Vite (desarrollo).
# En produccion hay que poner el dominio real del frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
